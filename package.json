{
  "name": "follow-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "dev:https": "tsx server.ts --https",
    "build": "next build",
    "start": "tsx server.ts --production",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
