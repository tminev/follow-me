generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AgeVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
}

enum ReportCategory {
  UNWANTED_CONTACT
  HARASSMENT
  THREAT
  SEXUAL_CONTENT
  FAKE_PROFILE
  BLOCK_EVASION
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARNING
  CONTACT_COOLDOWN
  SUSPEND
  BAN
  RESTORE
}

enum GameState {
  INVITED
  ACTIVE
  COMPLETED
  DECLINED
  EXPIRED
}

enum GameParticipantStatus {
  INVITED
  JOINED
  COMPLETED
  DECLINED
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
  FRIEND_REQUEST_DECLINED
  NEW_MESSAGE
  GAME_INVITATION
  GAME_UPDATE
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                    String @id @default(cuid())
  handle                String @unique
  email                 String @unique
  passwordHash          String
  declaredAdult         Boolean @default(false)
  dateOfBirth           DateTime
  ageVerificationStatus AgeVerificationStatus @default(UNVERIFIED)
  role                  UserRole @default(USER)
  accountStatus         AccountStatus @default(ACTIVE)
  createdAt             DateTime @default(now())
  profile               Profile?
  interests             UserInterest[]
  refreshSessions       RefreshSession[]
  sentRequests          FriendRequest[] @relation("sentRequests")
  receivedRequests      FriendRequest[] @relation("receivedRequests")
  friendshipsA          Friendship[] @relation("friendA")
  friendshipsB          Friendship[] @relation("friendB")
  blocksMade            UserBlock[] @relation("blocker")
  blocksReceived        UserBlock[] @relation("blocked")
  conversationMembers   ConversationMember[]
  messages              Message[]
  pushSubscriptions     PushSubscription[]
  notifications         Notification[]
  visibilitySessions    VisibilitySession[]
  visibilityExclusions  VisibilityExclusion[] @relation("visibilityOwner")
  excludedFrom          VisibilityExclusion[] @relation("visibilityExcluded")
  wallet                WalletBalance?
  progression           Progression?
  sparkLedger           SparkLedger[]
  xpLedger              XpLedger[]
  loyaltyLedger         LoyaltyLedger[]
  reportsMade           Report[] @relation("reporter")
  reportsReceived       Report[] @relation("reportedUser")
  gamesCreated          GameSession[] @relation("gameCreator")
  gameParticipants      GameParticipant[]
  moderationActionsMade ModerationAction[] @relation("moderator")
}

model Profile {
  userId          String @id
  displayName     String
  bio             String?
  city            String?
  neighborhood    String?
  avatarUrl       String?
  heightCm        Int?
  hairColor       String?
  interestsText   String?
  lookingFor      String?
  favoriteMovie   String?
  favoriteBook    String?
  occupation      String?
  education       String?
  languages       String?
  weekendStyle    String?
  firstDateIdea   String?
  profileVisibility String?
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Interest {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  users UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  @@id([userId, interestId])
}

model RefreshSession {
  id          String @id @default(cuid())
  userId      String
  hashedToken String @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  url       String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}

model FriendRequest {
  id          String @id @default(cuid())
  senderId    String
  receiverId  String
  intro       String?
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime @default(now())
  respondedAt DateTime?
  sender      User @relation("sentRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User @relation("receivedRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  @@unique([senderId, receiverId])
  @@index([receiverId, status])
}

model Friendship {
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User @relation("friendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User @relation("friendB", fields: [userBId], references: [id], onDelete: Cascade)
  @@id([userAId, userBId])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
}

model Conversation {
  id        String @id @default(cuid())
  createdAt DateTime @default(now())
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model VisibilitySession {
  id        String @id @default(cuid())
  userId    String
  startedAt DateTime @default(now())
  expiresAt DateTime
  endedAt   DateTime?
  shareMode String @default("APPROXIMATE")
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model VisibilityExclusion {
  ownerId        String
  excludedUserId String
  createdAt      DateTime @default(now())
  owner          User @relation("visibilityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  excludedUser   User @relation("visibilityExcluded", fields: [excludedUserId], references: [id], onDelete: Cascade)
  @@id([ownerId, excludedUserId])
}

model WalletBalance {
  userId    String @id
  balance   Int @default(0)
  version   Int @default(0)
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Progression {
  userId        String @id
  xp            Int @default(0)
  loyaltyPoints Int @default(0)
  level         Int @default(1)
  lastActiveAt  DateTime?
  updatedAt     DateTime @updatedAt
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SparkLedger {
  id             String @id @default(cuid())
  userId         String
  delta          Int
  eventType      String
  idempotencyKey String @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model XpLedger {
  id             String @id @default(cuid())
  userId         String
  delta          Int
  eventType      String
  idempotencyKey String @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model LoyaltyLedger {
  id             String @id @default(cuid())
  userId         String
  delta          Int
  eventType      String
  idempotencyKey String @unique
  createdAt      DateTime @default(now())
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model GameSession {
  id          String @id @default(cuid())
  gameCode    String
  state       GameState @default(INVITED)
  createdById String
  payload     Json?
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime @default(now())
  createdBy   User @relation("gameCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants GameParticipant[]
  @@index([createdById, createdAt])
  @@index([state, expiresAt])
}

model GameParticipant {
  gameId      String
  userId      String
  status      GameParticipantStatus @default(INVITED)
  answers     Json?
  joinedAt    DateTime?
  completedAt DateTime?
  game        GameSession @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([gameId, userId])
  @@index([userId, status])
}

model Report {
  id           String @id @default(cuid())
  reporterId   String
  targetUserId String?
  category     ReportCategory
  details      String?
  status       ReportStatus @default(OPEN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reporter     User @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User? @relation("reportedUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model ModerationAction {
  id          String @id @default(cuid())
  reportId    String?
  targetId    String
  moderatorId String
  action      ModerationActionType
  reason      String
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  moderator   User @relation("moderator", fields: [moderatorId], references: [id], onDelete: Restrict)
  @@index([targetId, createdAt])
}
